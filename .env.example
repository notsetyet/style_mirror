# ============================================
# StyleMirror 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入你的配置
# 注意：.env 文件包含敏感信息，已添加到 .gitignore

# ---------- OpenAI API 配置 ----------
# OpenAI API Key（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API Base URL（可选，用于代理或国产模型中转）
# 例如：https://api.openai.com/v1
# 或使用代理：https://your-proxy.com/v1
OPENAI_BASE_URL=

# ---------- 模型配置（可选） ----------
# 默认使用 gpt-4o-mini，可在代码中修改
# DEFAULT_MODEL=gpt-4o-mini
