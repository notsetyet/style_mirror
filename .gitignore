# ============================================
# StyleMirror 项目 .gitignore
# ============================================

# ---------- 环境变量（敏感信息） ----------
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 虚拟环境 ----------
venv/
ENV/
env/
.venv/

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- Streamlit ----------
.streamlit/secrets.toml

# ---------- 日志文件 ----------
*.log
logs/

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------- 测试覆盖率 ----------
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ---------- 临时文件 ----------
*.tmp
*.temp
temp/
tmp/
